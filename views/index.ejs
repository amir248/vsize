<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Корпусная мебель на заказ в Москве</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="shortcut icon" href="ico.png" type="image/x-icon">
<link rel="stylesheet" href="css/header.css">
<link rel="stylesheet" href="css/index.css">

<meta name="description" content="Vsize — компания, специализирующаяся на производстве корпусной мебели на заказ в Москве. Мы предлагаем индивидуальные решения для вашего интерьера с использованием качественных материалов, гарантируя стиль, функциональность и долговечность мебели для дома и офиса.">
<link rel="canonical" href="https://vsize.ru" />
<meta name="yandex-verification" content="8f08dad3ede64bf4" />
</head>

<body>

<header>
  <h1>VSIZE STUDIO</h1>
  <%- include('nav') %>
</header>

<div class="hero">
  <div class="hero-overlay">
    <h2>Корпусная мебель на заказ</h2>
    <p>Проектируем и создаём кухни, шкафы и гардеробные премиального уровня в Москве</p>
    <a class="btn" href="tel:+79137870404">Позвонить</a>
  </div>
</div>

<section>
  <h2 class="title">Почему выбирают нас</h2>
  <p class="subtitle">Мы делаем мебель как архитектурный проект — точно, чисто и без компромиссов</p>

  <div class="grid">
    <div class="card">
      <h3>Индивидуальный дизайн</h3>
      <p>Каждый проект создаётся под вашу планировку</p>
    </div>

    <div class="card">
      <h3>Премиальные материалы</h3>
      <p>Фурнитура и покрытия европейского уровня</p>
    </div>

    <div class="card">
      <h3>Чёткие сроки</h3>
      <p>Без задержек и “переносов на потом”</p>
    </div>
  </div>
</section>

<section>
  <h2 class="title">Как мы работаем</h2>

  <div class="steps">
    <div class="step">1. Заявка</div>
    <div class="step">2. Замер</div>
    <div class="step">3. Проект</div>
    <div class="step">4. Установка</div>
  </div>
</section>

<section>
  <h2 class="title">Оставить заявку</h2>
  <p class="subtitle">Мы перезвоним и сделаем расчёт стоимости бесплатно</p>

  <form id="orderForm" class="form">
    <input type="text" name="name" placeholder="Имя">
    <input type="tel" name="phone" placeholder="Телефон">
    <textarea rows="4" name="message" placeholder="Что хотите заказать?"></textarea>
    <button class="btn" type="submit">Отправить</button>
  </form>
</section>

<%- include('footer') %>

</body>
  <script defer src="js/main.js"></script>
  <script>
document.getElementById('orderForm').addEventListener('submit', async function(e) {
    e.preventDefault(); // предотвращаем обычную отправку формы

    const form = e.target;
    const name = form.name.value.trim();
    const phone = form.phone.value.trim();
    const message = form.message.value.trim();

    // Простая валидация
    if (!name) {
        alert('Пожалуйста, введите имя');
        form.name.focus();
        return;
    }

    if (!phone) {
        alert('Пожалуйста, введите телефон');
        form.phone.focus();
        return;
    }

    // Проверка телефона (только цифры и +)
    const phonePattern = /^[\d+]{5,20}$/;
    if (!phonePattern.test(phone)) {
        alert('Введите корректный телефон (только цифры и +)');
        form.phone.focus();
        return;
    }

    if (!message) {
        alert('Пожалуйста, напишите, что хотите заказать');
        form.message.focus();
        return;
    }

    // Если всё верно, отправляем на сервер
    const data = {
        to: 'daliashat@gmail.com',
        subject: `Заявка VSIZE от ${name}`,
        text: `Имя: ${name}\nТелефон: ${phone}\nСообщение: ${message}`
    };

    try {
        const res = await fetch('/api/send-mail', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {
            alert('Заявка отправлена! Мы скоро свяжемся.');
            form.reset();
        } else {
            alert('Ошибка: ' + result.error);
        }
    } catch (err) {
        alert('Ошибка при отправке: ' + err.message);
    }
});
</script>
